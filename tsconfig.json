{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true
	},
	/* src/frontend is bundled (and type-checked) separately: see tsconfig.frontend.json */
	"exclude": [
		"node_modules",
		"out",
		"dist",
		"src/frontend"
	]
}
